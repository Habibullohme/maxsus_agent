# Anthropic API kaliti: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Telegram bot tokeni: Telegramda @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=

# Faqat sizning Telegram ID raqamingiz (bir nechta bo'lsa vergul bilan).
# ID ni bilish uchun @userinfobot ga yozing.
TELEGRAM_ALLOWED_USER_IDS=

# Ixtiyoriy sozlamalar
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=medium
AGENT_DB_PATH=data/agent.db
AGENT_TIMEZONE=Asia/Tashkent
AGENT_MAX_TURNS=40
